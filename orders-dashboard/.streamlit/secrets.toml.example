# TEMPLATE ONLY — do NOT put real values in the repo.
# Paste the filled-in version into Streamlit Cloud → App → Settings → Secrets.
# Use a READ-ONLY Snowflake role/user scoped to the orders table.

[connections.snowflake]
account   = "xy12345.ap-south-1"     # your account identifier
user      = "STREAMLIT_READONLY"
role      = "STREAMLIT_READONLY_ROLE"
warehouse = "XS_WH"
database  = "ANALYTICS"
schema    = "PUBLIC"

# Option A (recommended): key-pair auth
private_key_file_pwd = ""
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"""

# Option B: password auth (only if key-pair isn't possible)
# password = "..."
