# TEMPLATE ONLY — real values go in Streamlit Cloud → App → Settings → Secrets.
# Never commit a filled-in copy. Use a READ-ONLY Snowflake user/role.

[snowflake]
account   = "xy12345.ap-south-1"        # account identifier (from your Snowflake URL)
user      = "STREAMLIT_READONLY"
role      = "STREAMLIT_READONLY_ROLE"
warehouse = "XS_WH"
database  = "ANALYTICS"
schema    = "PUBLIC"

# --- Option A (recommended): key-pair auth -------------------------------
# Paste the FULL contents of your .p8 file between the triple quotes.
private_key = """-----BEGIN PRIVATE KEY-----
PASTE_KEY_LINES_HERE
-----END PRIVATE KEY-----"""
private_key_passphrase = ""             # leave "" if the key isn't encrypted

# --- Option B: password auth (delete Option A lines if you use this) -----
# password = "..."
